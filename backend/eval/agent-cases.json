        "goalProposal": null,
        "reply": {
          "mustContainAny": [["confirm"]],
          "mustNotContain": ["i've saved", "i have saved", "is now saved", "successfully saved"],
          "mustNotMatch": [
            "(?<!\\bnothing )\\bhas been saved\\b",
            "(?<!\\bno (?:records|transactions|entries) )\\bhave been saved\\b",
            "(?<!\\bnothing has |\\bno (?:records|transactions|entries) have )\\bbeen recorded\\b",
            "(?<!haven't |have not |not )\\bsaved it\\b"
          ]
        }
      }
