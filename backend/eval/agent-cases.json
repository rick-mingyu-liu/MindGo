      "id": "en-yes-save-it",
      "language": "en",
      "message": "yes, save it",
      "history": [
        { "role": "user", "content": "I spent 12.50 on lunch at the SLC today." },
        { "role": "assistant", "content": "I drafted one expense: 12.50 CAD, Dining Out, 2026-10-14. Please review it and press Confirm to save." }
      ],
      "pendingRows": [{ "id": "3f1c2a9e-4b7d-4c1e-9a2f-5d6e7f8a9b0c", "amount": "12.50", "description": "Lunch at the SLC", "category": "Dining Out", "type": "expense", "date": "2026-10-14", "currency": "CAD" }],
