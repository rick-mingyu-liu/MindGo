# MindGo frontend — environment variables
#
# Copy to .env and fill in. Next.js only exposes variables prefixed with
# NEXT_PUBLIC_ to browser code; anything else is server-side only and, in a
# statically exported page, simply unavailable.
#
# Remember that NEXT_PUBLIC_ values are embedded in the JavaScript bundle and
# are readable by anyone who loads the page. Never put a secret behind that
# prefix — the backend holds the API keys for exactly this reason.


# Base URL of the MindGo backend. Defaults to http://localhost:3001 in
# utils/api.ts when unset. Set this to the deployed backend URL in production.
NEXT_PUBLIC_API_URL=http://localhost:3001


# ─── Not read by any code ────────────────────────────────────────────────────
# These appear in existing .env files but nothing in the frontend references
# them. Listed so their absence is not mistaken for an omission:
#
#   NEXT_PUBLIC_APP_NAME
#   NEXT_PUBLIC_APP_VERSION
#   EXCHANGE_RATE_API_KEY   — currency conversion happens in the backend
#   CUSTOM_KEY              — Next.js scaffolding, wired in next.config.js
#                             but never read
