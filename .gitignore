# oh-my-claudecode (OMC) state and artifacts
.omc/
.omc/state/
.omc/sessions/
.omc/logs/
.omc/plans/
.omc/research/
.omc/notepad.md
.omc/project-memory.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Environment files
.env
.env.local
.env.*.local

# Dependencies (also covered by subproject .gitignore files)
node_modules/

# Implementation plans — kept locally, not in the repo (specs stay tracked)
docs/superpowers/plans/

# Runtime probes: keep reproducible source/reports, ignore local session output
docs/superpowers/probes/**/*.private.json
docs/superpowers/probes/**/private-config/
docs/superpowers/probes/**/empty-cwd/
docs/superpowers/probes/**/results.json
